# linkedin-mcp — variables d'environnement (exemple). Copier en .env (gitignoré)
# et remplir. AUCUNE valeur réelle / secret ici : ce fichier est public.

# --- Serveur ---
# Port d'écoute HTTP.
PORT=3000
# URL publique (https derrière le reverse-proxy). Sert d'issuer OAuth + base des
# redirect_uri. En prod : https://mcp.stacko.fr
PUBLIC_URL=http://localhost:3000
# Dossier de données par client (data/<token>/). Volume persistant en prod.
DATA_DIR=./data

# --- Rendu (headless Chrome) ---
# Binaire Chrome/Chromium. Conteneur Linux : /usr/bin/chromium. Windows dev :
# C:/Program Files/Google/Chrome/Application/chrome.exe
CHROME_BIN=/usr/bin/chromium
# Budget de temps virtuel (ms) laissé au JS embarqué + chargement des polices.
# RENDER_VTB_MS=8000
# Timeout dur d'un rendu (ms) avant kill du process Chrome.
# RENDER_TIMEOUT_MS=30000

# --- Sessions MCP (bornage mémoire) ---
# TTL d'inactivité d'une session (ms) avant purge. Défaut 30 min.
# SESSION_TTL_MS=1800000
# Plafond du nombre de sessions simultanées (éviction LRU au-delà). Défaut 1000.
# SESSION_MAX=1000
# Période du balayage des sessions expirées (ms). Défaut 60 s.
# SESSION_SWEEP_MS=60000

# --- Arrêt propre ---
# Délai de grâce (ms) laissé aux rendus en vol au SIGTERM/SIGINT.
# SHUTDOWN_GRACE_MS=5000

# --- Publication LinkedIn (connect_linkedin / post_to_linkedin + démo) ---
# App LinkedIn. Sans ces deux valeurs, les autres outils marchent ; seule la
# publication LinkedIn est désactivée.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Redirect URI enregistré dans le portail LinkedIn. Par défaut dérivé de PUBLIC_URL
# (<PUBLIC_URL>/demo/linkedin/callback) — partagé par la démo et le flow MCP.
# LINKEDIN_REDIRECT_URI=
# Scopes OAuth LinkedIn (défaut : openid profile w_member_social).
# LINKEDIN_SCOPES=openid profile w_member_social

# --- Surface de démo (review LinkedIn) ---
# Identifiants de la porte de démo (/demo). Distincts de l'auth MCP.
DEMO_USER=
DEMO_PASS=
